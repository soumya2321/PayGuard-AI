# =====================================================================
# UPI Fraud Detection System — Environment Configuration
# =====================================================================

# ── Backend Server Settings ──────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
DEBUG=True

# ── Supabase PostgreSQL Database ─────────────────────────────────────
# Replace with your Supabase Project Settings -> API credentials:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-or-service-role-key

# Note: If SUPABASE_URL is left empty, the application automatically
# persists all transactions and alerts to the local SQLite database at:
# data/upi_fraud.db with zero configuration needed.
